      "name": "Webhook",
      "webhookId": "0d1c11e2-1d0e-4462-a054-ae10bca55e55"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=## Context\nVisitor name: {{ $json.knownName || \"unknown\" }}\nVisitor email: {{ $json.knownEmail || \"not provided\" }}\nReturning visitor: {{ $json.isKnown || \"No\" }}\nName collected: {{ $json.hasName || \"No\" }}\nEmail collected: {{ $json.hasEmail || \"No\" }}\nMesasage: {{ $('Webhook').item.json.body.message }}",
        "options": {
          "systemMessage": "=## Overview\n\nYou are a friendly AI receptionist for an AI automation agency named 'Sceflow AI'.\n\nYour tasks:\n\n1. Reply naturally to the user's message.\n2. Extract the person's name if mentioned.\n3. Extract the person's email if mentioned.\n4. Keep replies short, conversational, and human.\n5. Never sound robotic, overly formal, or like an AI assistant.\n6. If the user provides a name or email, acknowledge it naturally.\n7. If the name or email is not present, return an empty string.\n\n---\n\n## Instructions\n\n* Respond as if you are chatting with a real person.\n* Keep replies under 2 sentences whenever possible and also include a emoji like 😊 or something like wheere ever it is required to make it more friendly.\n* Do not use phrases like:\n\n  * \"I'd be happy to assist.\"\n  * \"Thank you for reaching out.\"\n  * \"How may I help you today?\"\n* Sound friendly and relaxed.\n* Extract only information explicitly mentioned by the user.\n* If unsure about a name or email, leave it empty.\n* Return valid JSON only.\n* Do not include markdown.\n* Do not include explanations.\n* Do not include code fences.\n\n\n---\n\n## Output Format\n\n{\n\"reply\": \"...\",\n\"extractedName\": \"...\",\n\"extractedEmail\": \"...\"\n}\n\n---\n\n## Examples\n\nUser:\n\"Hi, my name is John Smith\"\n\nOutput:\n{\n\"reply\": \"Nice to meet you, John. What can I help you with today?\",\n\"extractedName\": \"John Smith\",\n\"extractedEmail\": \"\"\n}\n\nUser:\n\"My email is [johnsmith@gmail.com](mailto:johnsmith@gmail.com)\"\n\nOutput:\n{\n\"reply\": \"Got it, thanks for sharing that😊. What would you like help with?\",\n\"extractedName\": \"\",\n\"extractedEmail\": \"[johnsmith@gmail.com](mailto:johnsmith@gmail.com)\"\n}\n\nUser:\n\"Hi, I'm Sarah and my email is [sarah@gmail.com](mailto:sarah@gmail.com)\"\n\nOutput:\n{\n\"reply\": \"Nice to meet you, Sarah😊. What are you looking to automate?\",\n\"extractedName\": \"Sarah\",\n\"extractedEmail\": \"[sarah@gmail.com](mailto:sarah@gmail.com)\"\n}\n\nUser:\n\"I want to automate my repetitive CRM tasks\"\n\nOutput:\n{\n\"reply\": \"That sounds interesting🧐. What part of your CRM workflow takes the most time right now?\",\n\"extractedName\": \"\",\n\"extractedEmail\": \"\"\n}\n\nUser:\n\"Can you help me?\"\n\nOutput:\n{\n\"reply\": \"Absolutely. Tell me a little about what you're trying to achieve.\",\n\"extractedName\": \"\",\n\"extractedEmail\": \"\"\n}\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1024,
        -96
      ],
      "id": "93424bba-a060-4833-b169-c859100a7442",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// SCEFLOW AI — CHATBOT CODE NODE (v3)\n// Parses AI JSON response\n// ============================================\n\nconst input = $input.first().json;\n\n// ─── GET RAW AI OUTPUT ─────────────────────\nconst rawOutput = input.output  || \n                  input.text    || \n                  input.aiReply || '';\n\n// ─── PARSE JSON FROM AI ────────────────────\nlet parsed = {};\ntry {\n  // Remove markdown code blocks if present\n  const cleaned = rawOutput\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n  \n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  // AI didn't return JSON — use raw as reply\n  parsed = {\n    reply: rawOutput,\n    extractedName: null,\n    extractedEmail: null\n  };\n}\n\n// ─── INPUT VARIABLES ───────────────────────\nconst knownName    = input.knownName    || '';\nconst knownEmail   = input.knownEmail   || '';\nconst messageCount = parseInt(input.messageCount) || 0;\nconst userMessage  = input.userMessage  || '';\nconst sessionId    = input.sessionId    || '';\n\n// ─── EXTRACTED VALUES FROM AI ──────────────\nconst aiReply      = parsed.reply         || rawOutput;\nconst detectedName = parsed.extractedName  || null;\nconst detectedEmail= parsed.extractedEmail || null;\n\n// ─── FINAL MERGED VALUES ───────────────────\n// Keep existing known values if AI found nothing new\nconst finalName  = detectedName  || knownName  || null;\nconst finalEmail = detectedEmail || knownEmail || null;\n\n// ─── NEW CAPTURE FLAGS ─────────────────────\nconst newNameCaptured = !!(\n  detectedName &&\n  detectedName.toLowerCase() !== knownName.toLowerCase()\n);\n\nconst newEmailCaptured = !!(\n  detectedEmail &&\n  detectedEmail.toLowerCase() !== knownEmail.toLowerCase()\n);\n\nconst shouldUpdateSheet = newNameCaptured || newEmailCaptured;\n\n// ─── STATUS ────────────────────────────────\nlet status = 'Browsing';\nif (finalEmail)            status = 'Lead Captured';\nelse if (finalName)        status = 'Name Captured';\nelse if (messageCount > 2) status = 'Engaged';\n\n// ─── OUTPUT ────────────────────────────────\nreturn [{\n  json: {\n    ...input,\n\n    // Clean AI reply for chat widget\n    aiReply,\n\n    // Name and email\n    extractedName:        finalName,\n    extractedEmail:       finalEmail,\n    detectedName:         detectedName,\n    detectedEmail:        detectedEmail,\n\n    // Flags for IF nodes\n    newNameCaptured,\n    newEmailCaptured,\n    shouldUpdateSheet,\n\n    // Updated values\n    updatedMessageCount:  messageCount + 1,\n    knownName:            finalName  || knownName,\n    knownEmail:           finalEmail || knownEmail,\n    status,\n    sessionId,\n    userMessage\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
